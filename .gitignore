# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*~

# Scratch and temp files that must never be committed
*.tmp
*.log
__pycache__/
.agent/

# Local overrides (never share machine-specific paths)
*.local.ps1
*.local.md

# build-deploy.ps1 output: the rendered bundle that gets installed. Regenerate with sync.ps1
# or toggle.ps1; it is derived, never edited by hand.
deploy/

# The on/off marker is local machine state, not a source change. Keep the source SKILL.md
# always-enabled in git; the marker decides what the DEPLOYED copy looks like.
**/.disabled
